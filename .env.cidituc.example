# Variables necesarias para el login con CiDiTuc (integración hub-ia).
# Copiá estas líneas a tu .env.local y completá los valores.

# Base del backend de CiDiTuc (el mismo que usa el muni). Sin slash final.
# Se le agrega /usuarios/authStatus para validar el token.
CIDITUC_BACKEND_URL=https://estadisticas.smt.gob.ar:5000

# URL de login de CiDiTuc (usa HashRouter). El botón le agrega "?next=hub-ia"
# para disparar el redirect de vuelta. La rama que hace que CiDiTuc vuelva con
# ?auth=<token> se implementa en el repo cidituc en la etapa A.
# IMPORTANTE: va ENTRE COMILLAS. En los .env el "#" inicia un comentario, así
# que sin comillas se pierde el "#/login" y el redirect no funciona.
# Para PROBAR LOCAL usá el cidituc local (NO producción, que no tiene la rama):
#   ojo con el puerto: vite usa 5173, pero si está ocupado salta a 5174, etc.
#   Mirá el puerto en la barra de cidituc y poné ese.
# Producción (cuando se despliegue la etapa A): "https://cidituc.smt.gob.ar/#/login"
NEXT_PUBLIC_CIDITUC_LOGIN_URL="http://localhost:5174/#/login"

# Secreto SOLO de hub-ia para firmar la cookie de sesión (HMAC-SHA256).
# Generá uno aleatorio, p.ej.:  openssl rand -hex 32
# No es el secreto de CiDiTuc: es independiente y vive solo acá.
HUBIA_SESSION_SECRET=peneduro

# Secreto JWT del backend de CiDiTuc (== JWT_SECRET_KEY del cidituc-backend).
# Se usa para verificar la firma del token localmente (HS256) sin llamar al
# backend por red, evitando la dependencia de su certificado TLS.
# DEBE coincidir exactamente con el del backend que emite los tokens.
CIDITUC_JWT_SECRET=

# Parche temporal (opcional): "true" permite que la consulta de perfil al backend
# tolere su certificado TLS incompleto, para poder mostrar nombre/email del
# usuario. La autenticación NO depende de esto. Apagar cuando infra arregle el cert.
CIDITUC_ALLOW_INSECURE_TLS=false

# Service role key de Supabase (Dashboard → Project Settings → API → service_role).
# Server-side únicamente. Se usa para:
#   - registrar/leer los ingresos de CiDiTuc (tabla cidituc_users) para el admin,
#   - crear el "usuario-sombra" de Supabase de cada vecino y prellenar su perfil
#     legal (ver lib/cidituc-provision.ts).
SUPABASE_SERVICE_ROLE_KEY=

# Dominio de los emails sintéticos del usuario-sombra de CiDiTuc (opcional).
# No se envía mail a estas direcciones; solo tienen que ser únicas y con formato
# válido. Por defecto: cidituc.local. Cambialo si querés usar un dominio propio.
CIDITUC_SHADOW_EMAIL_DOMAIN=cidituc.local
